{
  "ai": {
    "provider": "ali",
    "model": "qwen-plus",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "ai-native": {
        "threshold": 7.0,
        "topic_dedup": false
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "triton-lang",
        "repo": "triton",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Sean Goedecke",
        "url": "https://www.seangoedecke.com/rss.xml",
        "enabled": true,
        "category": "software-engineering",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending",
        "profile": "tech-news"
      },
      {
        "name": "Semianalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "enabled": true,
        "category": "semiconductors",
        "profile": "tech-news"
      },
      {
        "name": "LWN.net",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": true,
        "category": "linux-kernel",
        "profile": "tech-news"
      },
      {
        "name": "Eugene Yan",
        "url": "https://eugeneyan.com/rss/",
        "enabled": true,
        "profile": "ai-native",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Hamel Husain",
        "url": "https://hamel.dev/index.xml",
        "enabled": true,
        "profile": "ai-native",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Phil Calçado",
        "url": "https://philcalcado.com/feed.xml",
        "enabled": true,
        "profile": "ai-native",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Zalando Engineering",
        "url": "https://engineering.zalando.com/atom.xml",
        "enabled": true,
        "profile": "ai-native",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Chip Huyen",
        "url": "https://huyenchip.com/feed.xml",
        "enabled": true,
        "profile": "ai-native",
        "content_extractor": "trafilatura"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "profile": ["tech-news", "finance-news"]
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": null,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news",
      "ai-native"
    ],
    "topic_sections": {
      "ai-native": [
        {
          "id": "ai-native-product",
          "name": "AI-native product design",
          "display_names": {
            "zh": "AI Native 产品设计",
            "en": "AI-native product design"
          }
        },
        {
          "id": "ai-native-workflow",
          "name": "Team workflows and human-AI collaboration",
          "display_names": {
            "zh": "团队工作流与人机协作",
            "en": "Team workflows and human-AI collaboration"
          }
        },
        {
          "id": "ai-native-cases",
          "name": "Implementation cases, methods, and failures",
          "display_names": {
            "zh": "落地案例、方法与失败教训",
            "en": "Implementation cases, methods, and failures"
          }
        }
      ]
    },
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false
  }
}
